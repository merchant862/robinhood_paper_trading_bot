NODE_ENV=development

# Robinhood Chain public endpoints are fine for paper trading.
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_RPC_HTTP=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_RPC_WSS=wss://feed.mainnet.chain.robinhood.com

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=robinhood_bot
DB_USER=root
DB_PASSWORD=

# Green API WhatsApp alerts
GREEN_API_URL=https://api.green-api.com
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
WHATSAPP_CHAT_ID=923001234567@c.us
WHATSAPP_ENABLED=false
WHATSAPP_MIN_SCORE=70
WHATSAPP_MAX_ALERTS_PER_HOUR=30

# Paper trading
PAPER_TRADE_USD=50
PAPER_ENTRY_MIN_SCORE=70
PAPER_MAX_OPEN_TRADES=20
PAPER_MONITOR_MS=60000
PAPER_SUMMARY_MS=3600000
PAPER_STOP_LOSS_PERCENT=-50
PAPER_TAKE_PROFIT_PERCENT=100
PAPER_MOONBAG_PROFIT_PERCENT=500
PAPER_MAX_HOLD_HOURS=24

# Chain feed
SEQUENCER_FEED_ENABLED=true
CHAIN_POLL_MS=5000
CHAIN_HTTP_FALLBACK_MS=60000
CHAIN_LOOKBACK_BLOCKS=250
CHAIN_MAX_BLOCK_RANGE=200

# Polling/enrichment
DEXSCREENER_ENABLED=true
DEXSCREENER_POLL_MS=30000
